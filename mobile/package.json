{
  "name": "volleyball-manager-mobile",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Volleyball Manager for phones and tablets (Android and iPhone/iPad), held sideways.",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "npm run sync && vite",
    "build": "npm run sync && vite build",
